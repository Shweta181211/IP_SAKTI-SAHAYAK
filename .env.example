# Copy to .env and fill in. .env is gitignored - never commit a real key.
# We route LLM calls through OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults live in backend/app/config.py)
# Default is a FREE model. Switch to anthropic/claude-sonnet-5 once credits exist.
# IPSAKTI_MODEL=minimax/minimax-m3:free
# IPSAKTI_EMBED_MODEL=intfloat/multilingual-e5-base
