# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
# Generation runs through a THREE-PROVIDER fallback chain, defined in
# backend/app/config.py (`llm_chain`), in this order:
#
#     google  ->  groq  ->  openrouter
#
# A tier whose key is blank below is skipped automatically, so you do NOT need
# all three. But you need at least one WITH HEADROOM: every free tier here has
# a daily cap, and when every configured provider is capped the app refuses
# with "Safety check unavailable" rather than answering ungated. As of the
# September 2026 evaluation OpenRouter's free tier was fully exhausted, so an
# OpenRouter-only setup will look broken even though it is correctly configured.
#
# Cheapest working setup: a Google AI Studio key alone.

# Tier 1 - Google AI Studio (free tier, 15 requests/minute)
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tier 2 - Groq (free tier)
#   https://console.groq.com/keys
GROQ_API_KEY=

# Tier 3 - OpenRouter
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=


# --- Optional overrides (defaults live in backend/app/config.py) -------------
#
# Leave these commented out to use the fallback chain above. Set IPSAKTI_MODEL
# only to PIN one specific model ahead of the whole chain; it is prepended and
# shows as "override" in the logs.
#
# IPSAKTI_MODEL=anthropic/claude-sonnet-5
# IPSAKTI_API_KEY_ENV=OPENROUTER_API_KEY
# IPSAKTI_LLM_BASE_URL=https://openrouter.ai/api/v1
# IPSAKTI_EMBED_MODEL=intfloat/multilingual-e5-base
#
# Set to 0 to disable rate limiting when running the test suites, which fire
# faster than any human and would otherwise 429 themselves.
# IPSAKTI_RATE_LIMIT_QUERY=0
